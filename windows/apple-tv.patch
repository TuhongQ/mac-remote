+
+fn parse_button_mapping_query(raw_path: &str) -> Option<ButtonMapping> {
+    let (_, query) = raw_path.split_once('?')?;
+    let mut backward = None;
+    let mut forward = None;
+    for pair in query.split('&') {
+        let (key, value) = pair.split_once('=')?;
+        let action = ButtonAction::parse(value)?;
+        match key {
+            "backward" if backward.is_none() => backward = Some(action),
+            "forward" if forward.is_none() => forward = Some(action),
+            _ => return None,
+        }
+    }
+    Some(ButtonMapping { backward: backward?, forward: forward? })
+}
