--- /dev/null
+++ b/crates/atv-core/src/text_tracker.rs
@@ -0,0 +1,168 @@
+//! Turns the phone's Remote Text Input edits into keystrokes for the Mac.
+//!
+//! Captured traffic (iOS 27, Control Center remote) shows the phone does not
+//! send minimal edits. Because the simulated Apple TV never echoes its
+//! document state back, the phone keeps assuming the receiver's field is
+//! empty and, after almost every change, *restates the whole content of its
+//! own text field* as one `insertionText`:
+//!
+//! ```text
+//! Insert("可以")  Insert("可以说话")  Insert("可以说话吗")      // dictation
+//! Insert(",")    Insert("这是一棵苹果树,")                      // key + restatement
+//! Delete(1)      Insert("这是一棵苹果树,但")                    // backspace + restatement
+//! ```
+//!
+//! So the tracker mirrors the phone's field: it remembers what it has typed
+//! (`model`) and, for each restatement, sends only the difference
+//! (backspaces for the diverging tail, then the new suffix). Short inserts
+//! that are not a restatement (a single key or punctuation mark) are
+//! appended; the restatement that follows then matches and types nothing.
+//! `textToAssert` messages are resyncs the phone sends while dictating or
+//! after Return; acting on them deleted real text, so they are ignored.
+//!
+//! This module only uses `std` so it can be unit-tested standalone.
+
+/// One edit requested by the phone, applied in order.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum TextOp {
+    /// Replace the whole field with this text (`textToAssert`).
+    Assert(String),
+    /// Delete this many characters before the cursor.
+    Delete(usize),
+    /// Insert text at the cursor ("\n" means Return).
+    Insert(String),
+}
+
+/// A keystroke step for the Mac: press Backspace `back` times, then type `text`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Step {
+    pub back: usize,
+    pub text: String,
+}
+
+/// Inserts this short that are not restatements are treated as single keys.
+const SHORT_INSERT: usize = 2;
+
+#[derive(Debug, Default, Clone)]
+pub struct TextTracker {
+    /// What we believe the phone's field holds (and what we typed for it).
+    pub model: String,
+}
+
+impl TextTracker {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Forget the current field (new session / after Return).
+    pub fn reset(&mut self) {
+        self.model.clear();
+    }
+
+    pub fn apply(&mut self, op: &TextOp) -> Vec<Step> {
+        match op {
+            TextOp::Assert(_) => Vec::new(),
+            TextOp::Delete(n) => {
+                let keep = self.model.chars().count().saturating_sub(*n);
+                self.model = self.model.chars().take(keep).collect();
+                vec![Step { back: *n, text: String::new() }]
+            }
+            TextOp::Insert(raw) => {
+                // U+FFFC is the dictation placeholder (mic animation).
+                let t: String = raw.chars().filter(|c| *c != '\u{FFFC}').collect();
+                if t.is_empty() {
+                    return Vec::new();
+                }
+                if t == "\n" {
+                    self.model.clear();
+                    return vec![Step { back: 0, text: "\n".into() }];
+                }
+                let t_len = t.chars().count();
+                if t_len <= SHORT_INSERT && !self.model.is_empty() && t != self.model {
+                    self.model.push_str(&t);
+                    return vec![Step { back: 0, text: t }];
+                }
+                let common = self
+                    .model
+                    .chars()
+                    .zip(t.chars())
+                    .take_while(|(a, b)| a == b)
+                    .count();
+                let back = self.model.chars().count() - common;
+                let add: String = t.chars().skip(common).collect();
+                // A restatement that ends with Return: type it, then the
+                // next field starts empty.
+                let ends_with_return = add.ends_with('\n');
+                self.model = if ends_with_return { String::new() } else { t };
+                if back == 0 && add.is_empty() {
+                    Vec::new()
+                } else {
+                    vec![Step { back, text: add }]
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Applies steps to a simulated Mac text field.
+    fn run(ops: &[TextOp], start: &str) -> (String, usize) {
+        let mut mac: Vec<char> = start.chars().collect();
+        let mut t = TextTracker::new();
+        let mut keys = 0;
+        for op in ops {
+            for s in t.apply(op) {
+                keys += s.back + s.text.chars().count();
+                for _ in 0..s.back {
+                    mac.pop();
+                }
+                mac.extend(s.text.chars());
+            }
+        }
+        (mac.into_iter().collect(), keys)
+    }
+
+    fn ins(s: &str) -> TextOp {
+        TextOp::Insert(s.into())
+    }
+
+    #[test]
+    fn dictation_restatements_type_once() {
+        let ops = [ins("可以"), ins("可以说话"), ins("可以说话\u{FFFC}"), ins("可以说话"), ins("可以说话吗"), TextOp::Assert(String::new()), ins("可以说话吗\u{FFFC}"), ins("可以说话吗")];
+        assert_eq!(run(&ops, "").0, "可以说话吗");
+    }
+
+    #[test]
+    fn dictation_revision_rewrites_prefix() {
+        let ops = [ins("梨树"), ins("这是一棵树"), ins("这是一棵苹果树")];
+        assert_eq!(run(&ops, "").0, "这是一棵苹果树");
+    }
+
+    #[test]
+    fn key_then_restatement() {
+        let ops = [ins("这是一棵苹果树"), ins(","), ins("这是一棵苹果树,"), ins("但是"), ins("这是一棵苹果树,但是")];
+        assert_eq!(run(&ops, "").0, "这是一棵苹果树,但是");
+    }
+
+    #[test]
+    fn backspace_then_restatement() {
+        let ops = [ins("你好"), TextOp::Delete(1), ins("你"), TextOp::Delete(1)];
+        assert_eq!(run(&ops, "X").0, "X");
+    }
+
+    #[test]
+    fn return_starts_new_field() {
+        let ops = [ins("第一句"), ins("\n"), TextOp::Assert("第一句".into()), TextOp::Assert(String::new()), ins("双"), ins("双子"), ins("双手拿着一本书"), ins("\n")];
+        assert_eq!(run(&ops, "").0, "第一句\n双手拿着一本书\n");
+    }
+
+    #[test]
+    fn english_keys_with_restatement() {
+        let ops = [ins("h"), ins("h"), ins("e"), ins("he"), ins("l"), ins("hel"), ins("l"), ins("hell")];
+        assert_eq!(run(&ops, "").0, "hell");
+    }
+
+}
