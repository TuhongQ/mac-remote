index 0000000..b79878c
--- /dev/null
+++ b/crates/atv-core/src/text_input.rs
@@ -0,0 +1,329 @@
+//! Remote Text Input (RTI) support for the Companion `_tiStart` / `_tiC`
+//! messages.
+//!
+//! When a real Apple TV has a focused text field it answers the remote's
+//! `_tiStart` request with `_tiD`: an `NSKeyedArchiver` binary plist (archiver
+//! name `RTIKeyedArchiver`) describing the editing session (session UUID,
+//! document traits and current document state). The phone then shows its
+//! keyboard and streams edits back as `_tiC` events whose `_tiD` holds an
+//! archived `RTITextOperations` object (keyboard output with inserted text,
+//! deletion count, or a `textToAssert` that replaces the whole field).
+//!
+//! The archive layout here mirrors what pyatv sends/parses on the client
+//! side (`pyatv/protocols/companion/plist_payloads`), so it is a best-effort
+//! reconstruction. Every incoming archive can be dumped as XML via
+//! [`describe`] to adjust field names against captures from real devices.
+
+use plist::{Dictionary, Uid, Value as P};
+
+pub use crate::text_tracker::TextOp;
+
+/// Small helper that appends objects to an NSKeyedArchiver `$objects` table.
+struct Archive {
+    objects: Vec<P>,
+}
+
+impl Archive {
+    fn new() -> Self {
+        Self { objects: vec![P::String("$null".into())] }
+    }
+
+    fn push(&mut self, v: P) -> P {
+        self.objects.push(v);
+        P::Uid(Uid::new((self.objects.len() - 1) as u64))
+    }
+
+    fn class(&mut self, chain: &[&str]) -> P {
+        let mut d = Dictionary::new();
+        d.insert("$classname".into(), P::String(chain[0].into()));
+        d.insert(
+            "$classes".into(),
+            P::Array(chain.iter().map(|c| P::String((*c).into())).collect()),
+        );
+        self.push(P::Dictionary(d))
+    }
+
+    fn object(&mut self, chain: &[&str], fields: Vec<(&str, P)>) -> P {
+        // Reserve our slot first so the object precedes its class, like
+        // Foundation does; order is not semantically significant.
+        let idx = self.objects.len();
+        self.objects.push(P::String(String::new()));
+        let cls = self.class(chain);
+        let mut d = Dictionary::new();
+        for (k, v) in fields {
+            d.insert(k.into(), v);
+        }
+        d.insert("$class".into(), cls);
+        self.objects[idx] = P::Dictionary(d);
+        P::Uid(Uid::new(idx as u64))
+    }
+
+    fn finish(self, top: Vec<(&str, P)>) -> Vec<u8> {
+        let mut t = Dictionary::new();
+        for (k, v) in top {
+            t.insert(k.into(), v);
+        }
+        let mut root = Dictionary::new();
+        root.insert("$version".into(), P::from(100000u64));
+        root.insert("$archiver".into(), P::String("RTIKeyedArchiver".into()));
+        root.insert("$top".into(), P::Dictionary(t));
+        root.insert("$objects".into(), P::Array(self.objects));
+        let mut out = Vec::new();
+        P::Dictionary(root)
+            .to_writer_binary(&mut out)
+            .expect("writing a plist to memory cannot fail");
+        out
+    }
+}
+
+/// Build the `_tiD` payload announcing an active text-editing session.
+pub fn build_session_archive(session_uuid: &[u8; 16], current_text: &str, title: &str) -> Vec<u8> {
+    let mut a = Archive::new();
+
+    let uuid = a.object(
+        &["NSUUID", "NSObject"],
+        vec![("NS.uuidbytes", P::Data(session_uuid.to_vec()))],
+    );
+
+    let context = a.push(P::String(current_text.into()));
+    let ti_doc = a.object(
+        &["TIDocumentState", "NSObject"],
+        vec![("contextBeforeInput", context)],
+    );
+    let doc_state = a.object(&["RTIDocumentState", "NSObject"], vec![("docSt", ti_doc)]);
+
+    let ti_traits = a.object(
+        &["TITextInputTraits", "NSObject"],
+        vec![
+            ("autocapitalizationType", P::from(0u64)),
+            ("autocorrectionType", P::from(1u64)),
+            ("keyboardType", P::from(0u64)),
+            ("returnKeyType", P::from(0u64)),
+        ],
+    );
+    let title_v = a.push(P::String(title.into()));
+    let app_id = a.push(P::String("com.apple.TVSearch".into()));
+    let traits = a.object(
+        &["RTIDocumentTraits", "NSObject"],
+        vec![
+            ("tiTraits", ti_traits),
+            ("title", title_v.clone()),
+            ("prompt", title_v),
+            ("appId", app_id.clone()),
+            ("bundleId", app_id),
+        ],
+    );
+
+    a.finish(vec![
+        ("sessionUUID", uuid),
+        ("documentTraits", traits),
+        ("documentState", doc_state),
+    ])
+}
+
+fn parse(data: &[u8]) -> Option<P> {
+    P::from_reader(std::io::Cursor::new(data)).ok()
+}
+
+struct Reader<'a> {
+    objects: &'a [P],
+}
+
+impl<'a> Reader<'a> {
+    /// Follow a UID reference (or return the value itself).
+    fn deref(&self, v: &'a P) -> &'a P {
+        match v {
+            P::Uid(u) => self.objects.get(u.get() as usize).unwrap_or(v),
+            other => other,
+        }
+    }
+
+    fn field(&self, obj: &'a P, key: &str) -> Option<&'a P> {
+        let v = self.deref(obj).as_dictionary()?.get(key)?;
+        let v = self.deref(v);
+        match v {
+            P::String(s) if s == "$null" => None,
+            _ => Some(v),
+        }
+    }
+
+    fn string(&self, obj: &'a P, key: &str) -> Option<String> {
+        let v = self.field(obj, key)?;
+        if let Some(s) = v.as_string() {
+            return Some(s.to_string());
+        }
+        // NSMutableString / NSString archived as an object
+        self.field(v, "NS.string").and_then(|s| s.as_string().map(str::to_string))
+    }
+
+    fn int(&self, obj: &'a P, key: &str) -> Option<u64> {
+        let v = self.field(obj, key)?;
+        v.as_unsigned_integer()
+            .or_else(|| v.as_signed_integer().map(|i| i.max(0) as u64))
+    }
+}
+
+/// Session UUID announced in an archive (from `_tiStart`/`_tiStarted`).
+pub fn session_uuid(data: &[u8]) -> Option<[u8; 16]> {
+    let root = parse(data)?;
+    let dict = root.as_dictionary()?;
+    let objects = dict.get("$objects")?.as_array()?;
+    let r = Reader { objects };
+    let top = dict.get("$top")?;
+    // Session archives keep it at `$top.sessionUUID`; text-operation
+    // archives at `$top.textOperations.targetSessionUUID`.
+    let uuid = r
+        .field(top, "sessionUUID")
+        .or_else(|| r.field(top, "targetSessionUUID"))
+        .or_else(|| {
+            r.field(top, "textOperations")
+                .and_then(|ops| r.field(ops, "targetSessionUUID"))
+        })?;
+    let bytes = r.field(uuid, "NS.uuidbytes")?.as_data()?;
+    bytes.try_into().ok()
+}
+
+/// Extract the edits from an incoming `_tiC` archive (`RTITextOperations`).
+pub fn parse_operations(data: &[u8]) -> Vec<TextOp> {
+    let mut ops = Vec::new();
+    let Some(root) = parse(data) else { return ops };
+    let Some(dict) = root.as_dictionary() else { return ops };
+    let Some(objects) = dict.get("$objects").and_then(P::as_array) else { return ops };
+    let r = Reader { objects };
+
+    // Usually `$top.textOperations`; fall back to scanning every object so
+    // that small layout differences between iOS versions still work.
+    let mut candidates: Vec<&P> = Vec::new();
+    if let Some(top) = dict.get("$top") {
+        if let Some(t) = r.field(top, "textOperations") {
+            candidates.push(t);
+        }
+    }
+    if candidates.is_empty() {
+        candidates.extend(objects.iter().filter(|o| {
+            o.as_dictionary().map_or(false, |d| {
+                d.contains_key("keyboardOutput")
+                    || d.contains_key("textToAssert")
+                    || d.contains_key("editingActionSelector")
+            })
+        }));
+    }
+
+    for op in candidates {
+        if let Some(text) = r.string(op, "textToAssert") {
+            ops.push(TextOp::Assert(text));
+        }
+        if let Some(out) = r.field(op, "keyboardOutput") {
+            let deletions = r.int(out, "deletionCount").unwrap_or(0) as usize;
+            if deletions > 0 {
+                ops.push(TextOp::Delete(deletions));
+            }
+            // `textToCommit` (pinyin candidate) is always followed by an
+            // `insertionText` restating the field, so only the latter is used.
+            if let Some(text) = r.string(out, "insertionText") {
+                if !text.is_empty() {
+                    ops.push(TextOp::Insert(text));
+                }
+            }
+        }
+        if let Some(sel) = r.string(op, "editingActionSelector") {
+            // The keyboard's Return/Search/Go key.
+            if sel.contains("insertNewline") || sel.contains("Return") {
+                ops.push(TextOp::Insert("\n".into()));
+            }
+        }
+    }
+    ops
+}
+
+/// Build an `RTITextOperations` archive like pyatv does (used by tests and
+/// for sending a reset to the phone).
+pub fn build_text_operation(session_uuid: &[u8; 16], insert: Option<&str>, assert: Option<&str>) -> Vec<u8> {
+    let mut a = Archive::new();
+    let uuid = a.object(
+        &["NSUUID", "NSObject"],
+        vec![("NS.uuidbytes", P::Data(session_uuid.to_vec()))],
+    );
+    let mut fields = vec![("targetSessionUUID", uuid)];
+    if let Some(text) = insert {
+        let t = a.push(P::String(text.into()));
+        let out = a.object(&["TIKeyboardOutput", "NSObject"], vec![("insertionText", t)]);
+        fields.push(("keyboardOutput", out));
+    }
+    if let Some(text) = assert {
+        let t = a.push(P::String(text.into()));
+        fields.push(("textToAssert", t));
+    }
+    let ops = a.object(&["RTITextOperations", "NSObject"], fields);
+    a.finish(vec![("textOperations", ops)])
+}
+
+/// Build one keyboard edit like the phone sends it: `deletions` backspaces,
+/// then optional `insertionText` and pinyin `textToCommit` (test helper).
+pub fn build_keyboard_edit(
+    session_uuid: &[u8; 16],
+    deletions: usize,
+    insert: Option<&str>,
+    commit: Option<&str>,
+) -> Vec<u8> {
+    let mut a = Archive::new();
+    let uuid = a.object(
+        &["NSUUID", "NSObject"],
+        vec![("NS.uuidbytes", P::Data(session_uuid.to_vec()))],
+    );
+    let mut out_fields = Vec::new();
+    if deletions > 0 {
+        out_fields.push(("deletionCount", P::Integer((deletions as u64).into())));
+    }
+    if let Some(text) = insert {
+        out_fields.push(("insertionText", a.push(P::String(text.into()))));
+    }
+    if let Some(text) = commit {
+        out_fields.push(("textToCommit", a.push(P::String(text.into()))));
+    }
+    let out = a.object(&["TIKeyboardOutput", "NSObject"], out_fields);
+    let ops = a.object(
+        &["RTITextOperations", "NSObject"],
+        vec![("targetSessionUUID", uuid), ("keyboardOutput", out)],
+    );
+    a.finish(vec![("textOperations", ops)])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn roundtrip_insert() {
+        let uuid = [7u8; 16];
+        let data = build_text_operation(&uuid, Some("你好"), None);
+        assert_eq!(parse_operations(&data), vec![TextOp::Insert("你好".into())]);
+        assert_eq!(session_uuid(&data), Some(uuid));
+    }
+
+    #[test]
+    fn pinyin_commit() {
+        let mut a = Archive::new();
+        let t = a.push(P::String("你好".into()));
+        let out = a.object(&["TIKeyboardOutput", "NSObject"], vec![("textToCommit", t)]);
+        let ops = a.object(&["RTITextOperations", "NSObject"], vec![("keyboardOutput", out)]);
+        let data = a.finish(vec![("textOperations", ops)]);
+        assert!(parse_operations(&data).is_empty());
+    }
+
+    #[test]
+    fn roundtrip_assert() {
+        let data = build_text_operation(&[1u8; 16], None, Some(""));
+        assert_eq!(parse_operations(&data), vec![TextOp::Assert(String::new())]);
+    }
+
+    #[test]
+    fn session_archive_has_uuid() {
+        let uuid = [9u8; 16];
+        let data = build_session_archive(&uuid, "abc", "Mac");
+        assert_eq!(session_uuid(&data), Some(uuid));
+        assert!(parse(&data).is_some());
+    }
+
+
+}
diff --git a/crates/atv-core/src/text_tracker.rs b/crates/atv-core/src/text_tracker.rs
