index 0000000..0180b14
--- /dev/null
+++ b/crates/atv-core/src/gesture.rs
@@ -0,0 +1,120 @@
+//! Press-and-hold drag detection for the single-finger touch surface.
+//!
+//! The phone only ever reports one finger (`_tFg` is always 1), so a
+//! three-finger drag cannot be detected. Instead, like "drag lock" on a
+//! laptop touchpad: keep the finger still for `HOLD_NS`, then move it, and
+//! the touch becomes a drag (mouse button held down until the finger lifts).
+//! Moving straight away is plain pointer motion.
+
+/// How long the finger must rest before moving to start a drag.
+pub const HOLD_NS: u64 = 400_000_000;
+/// Movement (touchpad units, surface is 1000x1000) still counted as resting.
+pub const HOLD_SLOP: f64 = 20.0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// Not decided yet: the finger has not left the slop area.
+    Pending,
+    /// Ordinary pointer movement.
+    Pointer,
+    /// Mouse button is held down.
+    Drag,
+}
+
+#[derive(Debug, Clone)]
+pub struct HoldDrag {
+    start_ns: Option<u64>,
+    origin: (f64, f64),
+    kind: Kind,
+}
+
+impl Default for HoldDrag {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl HoldDrag {
+    pub fn new() -> Self {
+        Self { start_ns: None, origin: (0.0, 0.0), kind: Kind::Pointer }
+    }
+
+    /// Finger down. `ns` is the phone's `_ns` timestamp, if present.
+    pub fn begin(&mut self, ns: Option<u64>, origin: (f64, f64)) {
+        self.start_ns = ns;
+        self.origin = origin;
+        self.kind = if ns.is_some() { Kind::Pending } else { Kind::Pointer };
+    }
+
+    /// Finger moved. Returns the current kind and whether a drag just started.
+    pub fn update(&mut self, ns: Option<u64>, pos: (f64, f64)) -> (Kind, bool) {
+        if self.kind != Kind::Pending {
+            return (self.kind, false);
+        }
+        let dist = (pos.0 - self.origin.0).abs().max((pos.1 - self.origin.1).abs());
+        if dist < HOLD_SLOP {
+            return (Kind::Pending, false);
+        }
+        let held = match (self.start_ns, ns) {
+            (Some(s), Some(n)) => n.saturating_sub(s) >= HOLD_NS,
+            _ => false,
+        };
+        self.kind = if held { Kind::Drag } else { Kind::Pointer };
+        (self.kind, held)
+    }
+
+    pub fn kind(&self) -> Kind {
+        self.kind
+    }
+
+    /// Finger lifted or cancelled. Returns true if a drag was in progress.
+    pub fn end(&mut self) -> bool {
+        let was_drag = self.kind == Kind::Drag;
+        self.kind = Kind::Pointer;
+        self.start_ns = None;
+        was_drag
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MS: u64 = 1_000_000;
+
+    #[test]
+    fn quick_move_is_pointer() {
+        let mut g = HoldDrag::new();
+        g.begin(Some(0), (500.0, 500.0));
+        assert_eq!(g.update(Some(30 * MS), (510.0, 500.0)), (Kind::Pending, false));
+        assert_eq!(g.update(Some(60 * MS), (560.0, 500.0)), (Kind::Pointer, false));
+        assert_eq!(g.update(Some(900 * MS), (700.0, 500.0)), (Kind::Pointer, false));
+        assert!(!g.end());
+    }
+
+    #[test]
+    fn hold_then_move_is_drag() {
+        let mut g = HoldDrag::new();
+        g.begin(Some(0), (500.0, 500.0));
+        assert_eq!(g.update(Some(200 * MS), (505.0, 503.0)), (Kind::Pending, false));
+        assert_eq!(g.update(Some(450 * MS), (540.0, 500.0)), (Kind::Drag, true));
+        assert_eq!(g.update(Some(470 * MS), (580.0, 500.0)), (Kind::Drag, false));
+        assert!(g.end());
+        assert_eq!(g.kind(), Kind::Pointer);
+    }
+
+    #[test]
+    fn missing_timestamp_never_drags() {
+        let mut g = HoldDrag::new();
+        g.begin(None, (500.0, 500.0));
+        assert_eq!(g.update(None, (600.0, 500.0)), (Kind::Pointer, false));
+    }
+
+    #[test]
+    fn hold_without_move_is_not_drag() {
+        let mut g = HoldDrag::new();
+        g.begin(Some(0), (500.0, 500.0));
+        assert_eq!(g.update(Some(800 * MS), (502.0, 500.0)), (Kind::Pending, false));
+        assert!(!g.end());
+    }
+}
