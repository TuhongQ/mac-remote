+type Tlv = std::collections::BTreeMap<u8, Vec<u8>>;
+
+fn required_tlv(data: &Tlv, tag: u8) -> Result<&[u8]> {
+    data.get(&tag).map(Vec::as_slice).filter(|value| !value.is_empty())
+        .ok_or_else(|| Error::Protocol("missing pairing data".into()))
+}
+
+fn authenticate_client(data: &Tlv, public_key: &[u8; 32], parts: &[&[u8]]) -> Result<()> {
+    let invalid = |_| Error::Protocol("client signature verification failed".into());
+    let key = VerifyingKey::from_bytes(public_key).map_err(invalid)?;
+    let signature = Signature::from_slice(required_tlv(data, tags::SIGNATURE)?).map_err(invalid)?;
+    key.verify_strict(&parts.concat(), &signature).map_err(invalid)
+}
+
+fn pairing_path(server: &[u8], client: &[u8]) -> std::path::PathBuf {
+    crate::settings::get_settings_file_path()
+        .with_file_name("paired-controllers")
+        .join(hex::encode(Sha256::digest(server)))
+        .join(hex::encode(Sha256::digest(client)))
+}
+
 impl Drop for CompanionSession {
     fn drop(&mut self) {
+        if matches!(self.touch_drag.kind(), GestureKind::Drag) {
+            self.delegate.on_drag(0.0, 0.0, TouchPhase::Ended);
+        }
         if self.session_established.load(Ordering::SeqCst) {
             self.inspector.session_stopped();
         }
     }
 }

+
+/// Simulated iPhone remote messages and their resulting actions.
+#[cfg(test)]
+mod sim_tests {
+    use super::*;
+    use crate::crypto::CompanionCipher;
+    use crate::registry::{ActiveConnectionTracker, DeviceRegistry};
+    use std::sync::Mutex as StdMutex;
+    use std::time::Duration;
+
+    #[test]
+    fn client_signature_must_match_the_session() {
+        let key = SigningKey::from_bytes(&[11; 32]);
+        let public_key = key.verifying_key().to_bytes();
+        let parts: &[&[u8]] = &[b"client-session", b"controller", b"server-session"];
+        let signature = key.sign(&parts.concat()).to_bytes();
+        let proof = tlv::read(&tlv::write(&[(tags::SIGNATURE, &signature)]));
+        assert!(authenticate_client(&proof, &public_key, parts).is_ok());
+        assert!(authenticate_client(&Tlv::new(), &public_key, parts).is_err());
+        assert!(authenticate_client(&proof, &public_key, &[b"other-session"]).is_err());
+    }
+
+    #[derive(Default)]
+    struct Recorder {
+        log: StdMutex<Vec<String>>,
+        text: StdMutex<String>,
+    }
+
+    impl Recorder {
+        fn take(&self) -> Vec<String> {
+            std::mem::take(&mut *self.log.lock().unwrap())
+        }
+        fn count(log: &[String], prefix: &str) -> usize {
+            log.iter().filter(|l| l.starts_with(prefix)).count()
+        }
+    }
+
+    impl AtvDelegate for Recorder {
+        fn on_button(&self, name: &str) {
+            self.log.lock().unwrap().push(format!("button {name}"));
+        }
+        fn on_touch(&self, dx: f64, dy: f64, phase: TouchPhase) {
+            self.log.lock().unwrap().push(format!("touch {phase:?} {dx} {dy}"));
+        }
+        fn on_scroll(&self, dx: f64, dy: f64) {
+            self.log.lock().unwrap().push(format!("scroll {dx} {dy}"));
+        }
+        fn on_drag(&self, dx: f64, dy: f64, phase: TouchPhase) {
+            self.log.lock().unwrap().push(format!("drag {phase:?} {dx} {dy}"));
+        }
+        fn on_text_insert(&self, text: &str) {
+            self.text.lock().unwrap().push_str(text);
+            self.log.lock().unwrap().push(format!("insert {text:?}"));
+        }
+        fn on_text_delete(&self, count: usize) {
+            let mut t = self.text.lock().unwrap();
+            for _ in 0..count {
+                t.pop();
+            }
+            self.log.lock().unwrap().push(format!("delete {count}"));
+        }
+        fn on_event(&self, kind: EventKind, _detail: &str) {
+            if kind == EventKind::MouseClick {
+                self.log.lock().unwrap().push("click".into());
+            }
+        }
+    }
+
+    async fn session(mode: TrackpadMode) -> (CompanionSession, Arc<Recorder>, tokio::task::JoinHandle<()>) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let client = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let (server, _) = listener.accept().await.unwrap();
+        // Drain whatever the session sends back to the "phone".
+        let drain = tokio::spawn(async move {
+            use tokio::io::AsyncReadExt;
+            let mut c = client;
+            let mut buf = [0u8; 4096];
+            while matches!(c.read(&mut buf).await, Ok(n) if n > 0) {}
+        });
+        let (_r, w) = server.into_split();
+        let rec = Arc::new(Recorder::default());
+        let identity = DeviceIdentity::detect();
+        let mut s = CompanionSession::new(
+            Arc::new(Mutex::new(w)),
+            rec.clone(),
+            &identity,
+            1111,
+            Arc::new(AtomicBool::new(mode == TrackpadMode::Mouse)),
+            Arc::new(AtomicU8::new(mode as u8)),
+            InspectorHub::new(),
+            Arc::new(Mutex::new(DeviceRegistry::new(Duration::from_secs(60)))),
+            Arc::new(Mutex::new(ActiveConnectionTracker::new())),
+            1,
+            "127.0.0.1".into(),
+            Arc::new(AtomicBool::new(false)),
+        );
+        // Pretend pair-verify finished so responses can be encrypted.
+        s.cipher = Some(CompanionCipher::new(&[1; 32], &[2; 32], 12).unwrap());
+        (s, rec, drain)
+    }
+
+    fn msg(id: &str, xid: u64, content: Value) -> Value {
+        Value::dict(vec![
+            Value::kv("_i", Value::Str(id.into())),
+            Value::kv("_x", Value::Int(xid)),
+            Value::kv("_t", Value::Int(2)),
+            Value::kv("_c", content),
+        ])
+    }
+
+    fn touch(ns: u64, phase: u64, x: f64, y: f64) -> Value {
+        msg(
+            "_hidT",
+            0,
+            Value::dict(vec![
+                Value::kv("_ns", Value::Int(ns)),
+                Value::kv("_tFg", Value::Int(1)),
+                Value::kv("_tPh", Value::Int(phase)),
+                Value::kv("_cx", Value::Int(x as u64)),
+                Value::kv("_cy", Value::Int(y as u64)),
+            ]),
+        )
+    }
+
+    #[tokio::test]
+    async fn media_seek_buttons_dispatch_once_per_action() {
+        let (mut s, rec, _drain) = session(TrackpadMode::Mouse).await;
+        for (index, (identifier, key, command, seconds)) in [
+            ("_mcc", "_mcc", 7, 10.0),
+            ("MediaControlCommand", "MediaControlCommand", 7, -10.0),
+            ("_mcc", "_mcc", 7, 0.0),
+            ("_mcc", "_mcc", 8, 0.0),
+            ("_mcc", "_mcc", 9, 0.0),
+            ("_mcc", "_mcc", 10, 0.0),
+            ("_mcc", "_mcc", 11, 0.0),
+        ].into_iter().enumerate() {
+            let content = Value::dict(vec![
+                Value::kv(key, Value::Int(command)),
+                Value::kv("_skpS", Value::Double(seconds)),
+            ]);
+            s.handle_control(&msg(identifier, index as u64 + 1, content)).await.unwrap();
+        }
+        assert_eq!(rec.take(), [
+            "button skip_forward", "button skip_backward",
+            "button skip_forward", "button skip_backward",
+        ]);
+    }
+
+    #[tokio::test]
+    async fn hold_then_move_drags_without_click() {
+        let (mut s, rec, _d) = session(TrackpadMode::Mouse).await;
+        let ms = 1_000_000u64;
+        s.handle_control(&touch(0, 1, 400.0, 500.0)).await.unwrap();
+        s.handle_control(&touch(300 * ms, 2, 403.0, 501.0)).await.unwrap();
+        s.handle_control(&touch(500 * ms, 2, 450.0, 500.0)).await.unwrap();
+        s.handle_control(&touch(520 * ms, 2, 500.0, 520.0)).await.unwrap();
+        s.handle_control(&touch(540 * ms, 4, 500.0, 520.0)).await.unwrap();
+        let log = rec.take();
+        let drags: Vec<_> = log.iter().filter(|l| l.starts_with("drag")).cloned().collect();
+        assert_eq!(drags, ["drag Began 0 0", "drag Moved 47 -1", "drag Moved 50 20", "drag Ended 0 0"]);
+        assert_eq!(Recorder::count(&log, "click"), 0, "{log:?}");
+    }
+
+    #[tokio::test]
+    async fn cancelled_drag_releases_button() {
+        let (mut s, rec, _d) = session(TrackpadMode::Mouse).await;
+        let ms = 1_000_000u64;
+        s.handle_control(&touch(0, 1, 400.0, 500.0)).await.unwrap();
+        s.handle_control(&touch(600 * ms, 2, 450.0, 500.0)).await.unwrap();
+        s.handle_control(&touch(620 * ms, 5, 450.0, 500.0)).await.unwrap();
+        let log = rec.take();
+        assert_eq!(log.last().unwrap(), "drag Ended 0 0", "{log:?}");
+    }
+
+    #[tokio::test]
+    async fn right_edge_scrolls_and_quick_tap_clicks() {
+        let (mut s, rec, _d) = session(TrackpadMode::Mouse).await;
+        let ms = 1_000_000u64;
+        s.handle_control(&touch(0, 1, 900.0, 300.0)).await.unwrap();
+        s.handle_control(&touch(20 * ms, 2, 900.0, 400.0)).await.unwrap();
+        s.handle_control(&touch(40 * ms, 4, 900.0, 450.0)).await.unwrap();
+        s.handle_control(&touch(900 * ms, 1, 300.0, 300.0)).await.unwrap();
+        s.handle_control(&touch(950 * ms, 4, 302.0, 301.0)).await.unwrap();
+        let log = rec.take();
+        assert_eq!(Recorder::count(&log, "scroll 0 100"), 1, "{log:?}");
+        assert_eq!(Recorder::count(&log, "touch Moved"), 0, "{log:?}");
+        assert_eq!(Recorder::count(&log, "click"), 1, "{log:?}");
+        assert_eq!(Recorder::count(&log, "drag"), 0, "{log:?}");
+    }
+}
